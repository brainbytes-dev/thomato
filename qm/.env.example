DATABASE_URL=postgres://qm:qm@localhost:5437/qm_dev
DATABASE_URL_DIRECT=postgres://qm:qm@localhost:5437/qm_dev
# Laufzeit (Vercel): qm_app, gepoolt. DATABASE_URL_DIRECT: Besitzer, direkt (Migrationen, db:roles, Seed).
# QM_APP_PASSWORD wird nur von `pnpm db:roles` gelesen (Passwort der Rolle qm_app), nie von der App.
QM_APP_PASSWORD=
# Tests: Besitzer-Verbindung der Test-DB. TEST_APP_DATABASE_URL (qm_app) wird in vitest.config.mts daraus abgeleitet.
TEST_DATABASE_URL=postgres://qm:qm@localhost:5437/qm_test
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
